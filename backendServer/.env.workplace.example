# Apply Prisma migrations before starting this release, even with flags disabled.
NOTICES_ENABLED=false
INCIDENTS_ENABLED=false
LOST_PROPERTY_ENABLED=false
# Use the existing BUSINESS_TIMEZONE setting; Australia/Sydney is the default.
BUSINESS_TIMEZONE=Australia/Sydney

# Server-only credentials. The bucket must exist and public must be false.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WORKPLACE_BUCKET=workplace-private

# Optional: a dedicated migrated database whose name ends in _test.
# Never set this to the application's database.
TEST_DATABASE_URL=
