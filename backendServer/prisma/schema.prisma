// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════

enum CustomerType {
  ORGANIZATION
  CORPORATE
  TRAVEL_AGENT
  SCHOOL
  COMMUNITY_GROUP
  INDIVIDUAL
  OTHER
}

enum Department {
  OPERATION
  ADMINISTRATION
  MANAGEMENT
}

enum EmployeeRole {
  YARD
  DRIVER
  ADMIN
  DISPATCHER
  MANAGER
  MECHANIC
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum PaymentMethod {
  CREDIT_CARD
  INVOICE
  BANK_TRANSFER
  CASH
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30
  NET_60
}

enum AccountStanding {
  GOOD
  WARNING
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ══════════════════════════════════════════════════════════════
// EXISTING MODELS (with added indexes and new relations)
// ══════════════════════════════════════════════════════════════

model User {
  clerkId String? @unique
 notices Notice[]
 noticeRevisions NoticeRevision[]
 noticeRecipients NoticeRecipient[]
 reportedIncidents Incident[] @relation("IncidentReporter")
 ownedIncidents Incident[] @relation("IncidentOwner")
 incidentUpdates IncidentUpdate[]
 completedIncidentActions IncidentAction[]
 propertyReports LostPropertyReport[] @relation("PropertyReporter")
 handledPropertyReports LostPropertyReport[] @relation("PropertyOwner")
 foundItems FoundPropertyItem[] @relation("ItemReporter")
 handledItems FoundPropertyItem[] @relation("ItemOwner")
 heldItems FoundPropertyItem[] @relation("ItemCustodian")
 propertyMatches PropertyMatch[]
 custodyEvents PropertyCustodyEvent[]
 transfersFrom PropertyCustodyEvent[] @relation("CustodyFrom")
 transfersTo PropertyCustodyEvent[] @relation("CustodyTo")
 attachments Attachment[]
 notifications Notification[]

  id             Int             @id @default(autoincrement())
  email          String          @unique
  employeeNumber String?         @unique
  firstName      String?
  lastName       String?
  address        String?
  department     Department?
  role           EmployeeRole?
  employmentType EmploymentType?
  status         EmployeeStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  hireDate                 DateTime?
  terminationDate          DateTime?
  hourlyRate               Decimal?  @db.Decimal(10, 2)
  skills                   String[]
  hrNotes                  String?

  // One-to-one with UserProfile
  profile UserProfile?

  // NEW: Dispatch relations
  assignments        Assignment[]
  driverAvailability DriverAvailability[]

  // Reverse relation: Vehicle assigned to this driver
  assignedVehicle FleetVehicle? @relation("VehicleDriver")

  @@index([status])
  @@index([email])
}

model UserProfile {
  id                  Int       @id @default(autoincrement())
  address             String?
  avatarUrl           String?
  bankAccount         Int?
  bankBSB             String?
  bankName            String?
  phoneNumber1        String?
  phoneNumber2        String?
  dateOfBirth         DateTime?
  driverLicense       String?
  driverLicenseExpiry DateTime?
  driverLicenseState  String?
  taxFileNumber       String?
  occupation          String?
  maxfatigueMinutes   Int?      @default(300) // default to 5 hours
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  propertyReports LostPropertyReport[]

  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  address      String?
  company      String?
  phone1       String?
  phone2       String?
  customerType CustomerType @default(INDIVIDUAL)

  contactName            String?
  contactRole            String?
  taxId                  String?
  preferredPaymentMethod PaymentMethod?
  paymentTerms           PaymentTerms?
  internalNotes          String?
  isVip                  Boolean         @default(false)
  accountStanding        AccountStanding @default(GOOD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  // One-to-many relationship
  bookings Booking[]

  @@index([isActive])
}

model Booking {
  routeCalculation Json?
  outboundItinerary Json?
  returnItinerary Json?
  returnItineraryConfirmed Boolean @default(false)
  incidents Incident[]
 propertyReports LostPropertyReport[]
 foundItems FoundPropertyItem[]

  id             Int       @id @default(autoincrement())
  subject        String
  inquiryDetails String?
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  noOfVehicles   Int?      @default(1)
  passengerCount Int?      @default(0)
  tripCount      Int?      @default(1)
  startDateTime  DateTime
  startLocation  String
  endLocation    String
  endDateTime    DateTime?

  // Booking type: one_way | round_trip | repeatable
  bookingType String @default("one_way")

  // Structured location data
  pickupLat      Float?
  pickupLng      Float?
  pickupPlaceId  String?
  dropoffLat     Float?
  dropoffLng     Float?
  dropoffPlaceId String?

  // Round trip fields
  returnDateTime  DateTime?
  returnEndDateTime DateTime?
  waitingDuration Int? // minutes

  // Repeatable booking recurrence rule (JSON)
  recurrenceRule Json? // { type, days, startDate, endDate }

  // Foreign key
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // One-to-many relationship
  jobs Job[]
  timeZone String @default("Australia/Sydney")
  stops Json?
  confirmedAt DateTime?
  confirmationSource String?
  amendsBookingId Int?
  revision Int @default(1)
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@index([startDateTime])
  @@index([bookingType])
}

model Job {
  itinerary Json?
  direction String?
  incidents Incident[]
 propertyReports LostPropertyReport[]
 foundItems FoundPropertyItem[]

  id               Int       @id @default(autoincrement())
  driverStatus     Boolean   @default(false)
  driverStatusAt   DateTime?
  jobStartLocation String?
  jobEndLocation   String?
  jobStartDateTime DateTime?
  jobEndDateTime   DateTime?
  jobNotes         String?
  jobPriority      String?
  jobCategory      String?
  status           String    @default("OPEN")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  jobStartLat      Float?
  jobStartLng      Float?
  jobEndLat        Float?
  jobEndLng        Float?
  /// Duration in hours (e.g. 1.5 = 1h 30m)
  durationHours    Decimal?  @db.Decimal(5, 2)

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId Int?

  // NEW: Dispatch assignments
  assignments Assignment[]

  @@index([bookingId])
  @@index([status])
  @@index([jobStartDateTime])
}

model FleetVehicle {
  facilities String[] @default([])
  incidents Incident[]
 propertyReports LostPropertyReport[]
 foundItems FoundPropertyItem[]

  id             Int       @id @default(autoincrement())
  make           String
  model          String
  year           Int
  licensePlate   String    @unique
  regoState      String?
  vin            String    @unique
  status         String    @default("ACTIVE")
  availableFrom  DateTime?
  availableTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  maxPassengers  Int?
  maxCargoVolume Decimal?  @db.Decimal(10, 2) // in cubic

  // NEW: Dispatch assignments
  assignments Assignment[]

  homeDepotId Int?
  homeDepot   Depot? @relation(fields: [homeDepotId], references: [id])

  // Assigned driver for this vehicle
  assignedDriverId Int?  @unique
  assignedDriver   User? @relation("VehicleDriver", fields: [assignedDriverId], references: [id])

  @@index([status])
}

// ══════════════════════════════════════════════════════════════
// NEW MODELS — Dispatch Module
// ══════════════════════════════════════════════════════════════

/// Dispatch assignment — links a Job to a Driver and/or Vehicle with scheduling.
/// Replaces raw UserJob/FleetJob for dispatch workflows.
/// Includes optimistic locking via `version` field.
model Assignment {
  positioningRouteIds Json?
  incidents Incident[]

  id             Int              @id @default(autoincrement())
  jobId          Int
  driverId       Int?
  vehicleId      Int?
  status         AssignmentStatus @default(PENDING)
  scheduledStart DateTime
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  version        Int              @default(1) // Optimistic locking
  notes          String?
  createdBy      Int? // Dispatcher user ID
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Travel segment: how the driver gets TO this job
  travelFromLocation String? // "depot" or "lat,lng" of previous job end
  travelToMinutes    Int? // Estimated travel time in minutes
  travelToKm         Float? // Estimated travel distance in km
  bufferMinutes      Int? // Buffer/rest time added after travel (default 10)

  job     Job           @relation(fields: [jobId], references: [id])
  driver  User?         @relation(fields: [driverId], references: [id])
  vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id])

  @@index([jobId])
  @@index([driverId, scheduledStart])
  @@index([vehicleId, scheduledStart])
  @@index([status])
}

/// Structured activity log — replaces the broken 1:1 AuditLog model.
/// Supports unlimited entries per user and stores JSON change diffs.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String // ASSIGNMENT_CREATED, BOOKING_STATUS_CHANGED, etc.
  entity    String // Assignment, Booking, Job
  entityId  Int
  changes   Json? // { before: {...}, after: {...} }
  userId    Int? // Who performed the action
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
}

/// Driver availability windows — recurring or one-off.
/// Used by ConflictService to check if a driver can be assigned.
model DriverAvailability {
  id        Int      @id @default(autoincrement())
  driverId  Int
  dayOfWeek Int? // 0=Sun, 6=Sat (null = specific date override)
  startTime DateTime
  endTime   DateTime
  isBlocked Boolean  @default(false) // true = driver is unavailable
  reason    String?
  source    String @default("MANUAL")
  createdAt DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id])

  @@index([driverId, startTime])
}

model Quotation {
  estimateReference Json?
  routingReferences Json?
  id Int @id @default(autoincrement())
  bookingId Int
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  revision Int
  status String @default("DRAFT")
  currency String @default("AUD")
  discountMinor Int @default(0)
  taxBasisPoints Int @default(0)
  subtotalMinor Int
  taxMinor Int
  totalMinor Int
  expiresAt DateTime
  terms String @default("")
  message String @default("")
  snapshot Json
  tokenHash String? @unique
  tokenCipher String?
  sentAt DateTime?
  respondedAt DateTime?
  respondentName String?
  responseReason String?
  createdAt DateTime @default(now())
  items QuotationItem[]
  deliveries EmailDelivery[]
  @@unique([bookingId, revision])
  @@index([status, expiresAt])
}

model QuotationItem {
  id Int @id @default(autoincrement())
  quotationId Int
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position Int
  description String
  quantity Int
  unitPriceMinor Int
  totalMinor Int
}

// Durable email outbox. Uncertain sends require reconciliation, not blind retry.
model EmailDelivery {
  id String @id @default(uuid())
  quotationId Int
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  kind String @default("QUOTATION")
  recipient String
  status String @default("QUEUED")
  attempts Int @default(0)
  providerMessageId String? @unique
  lastError String?
  nextAttemptAt DateTime @default(now())
  claimedAt DateTime?
  deliveredAt DateTime?
  lastEventAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
}

model WorkflowEvent {
  id Int @id @default(autoincrement())
  type String
  payload Json
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt])
}

/// Short-lived pessimistic lock for multi-dispatcher conflict prevention.
/// Automatically expires after the TTL (checked via expiresAt).
model DispatchLock {
  id           Int      @id @default(autoincrement())
  resourceType String // "DRIVER" | "VEHICLE" | "JOB"
  resourceId   Int
  lockedBy     Int // Dispatcher user ID
  lockedAt     DateTime @default(now())
  expiresAt    DateTime // Auto-expire after ~10 seconds

  @@unique([resourceType, resourceId])
  @@index([expiresAt])
}

model AutoScheduleRun {
  id        Int      @id @default(autoincrement())
  runDate   DateTime @default(now())
  startDate DateTime
  endDate   DateTime
  success   Boolean  @default(true)
  notes     String?

  @@unique([startDate, endDate])
}

model TravelTimeCache {
  id              Int      @id @default(autoincrement())
  origin          String // E.g., "depot" or "lat,lng"
  destination     String // E.g., "lat,lng" or address
  durationMinutes Int
  distanceKm      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([origin, destination])
}

/// Depot locations for drivers and vehicles
model Depot {
  foundItems FoundPropertyItem[]

  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles FleetVehicle[]
}

/// Configurable scheduling settings — key-value store.
/// Used by the scheduling engine to retrieve configurable rules.
model SchedulingSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Notice {
  id Int @id @default(autoincrement())
  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status String @default("DRAFT")
  version Int @default(1)
  currentRevision Int @default(1)
  publishAt DateTime?
  publishedAt DateTime?
  pinned Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions NoticeRevision[]
  attachments Attachment[]
  @@index([status, publishAt])
}

model NoticeRevision {
  id Int @id @default(autoincrement())
  noticeId Int
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  revision Int
  title String
  body String
  category String
  priority String
  audience EmployeeRole[]
  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  recipients NoticeRecipient[]
  @@unique([noticeId, revision])
}

model NoticeRecipient {
  id Int @id @default(autoincrement())
  revisionId Int
  revision NoticeRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  snapshot Boolean @default(true)
  readAt DateTime?
  acknowledgedAt DateTime?
  @@unique([revisionId, userId])
}

model Incident {
  id Int @id @default(autoincrement())
  reference String?
  title String
  description String
  occurredAt DateTime
  location String
  category String
  severity String
  immediateAction String @default("")
  unsafeVehicle Boolean @default(false)
  fleetDecision String?
  status String @default("SUBMITTED")
  version Int @default(1)
  reporterId Int
  reporter User @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  ownerId Int?
  owner User? @relation("IncidentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  dueAt DateTime?
  resolution String?
  injury Boolean @default(false)
  emergencyServices Boolean @default(false)
  policeInvolved Boolean @default(false)
  safeToContinue Boolean @default(true)
  investigationSummary String @default("")
  correctiveActions String @default("")
  internalNotes String @default("")
  outcomeSummary String @default("")
  duplicateOfId Int?
  duplicateOf Incident? @relation("IncidentDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates Incident[] @relation("IncidentDuplicate")
  vehicleId Int?
  vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookingId Int?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  jobId Int?
  job Job? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignmentId Int?
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updates IncidentUpdate[]
  actions IncidentAction[]
  attachments Attachment[]
  @@index([status, createdAt])
  @@index([reporterId])
  @@index([ownerId, dueAt])
  @@index([vehicleId, occurredAt])
  @@index([bookingId])
  @@index([jobId])
}

model IncidentUpdate {
  id Int @id @default(autoincrement())
  incidentId Int
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  authorId Int
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body String
  officeOnly Boolean @default(false)
  createdAt DateTime @default(now())
  attachments Attachment[]
}

model IncidentAction {
  id Int @id @default(autoincrement())
  incidentId Int
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  description String
  completedAt DateTime?
  completedById Int?
  completedBy User? @relation(fields: [completedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model LostPropertyReport {
  id Int @id @default(autoincrement())
  description String
  category String
  colour String @default("")
  brand String @default("")
  identifyingDetails String @default("")
  occurredAt DateTime
  location String
  status String @default("OPEN")
  version Int @default(1)
  reporterId Int
  reporter User @relation("PropertyReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  ownerId Int?
  owner User? @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  vehicleId Int?
  vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookingId Int?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  jobId Int?
  job Job? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  customerId Int?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  privateDetails PropertyClaimant?
  matches PropertyMatch[]
  attachments Attachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, occurredAt])
  @@index([reporterId])
  @@index([ownerId])
  @@index([vehicleId, occurredAt])
  @@index([bookingId])
  @@index([jobId])
}

model PropertyClaimant {
  id Int @id @default(autoincrement())
  reportId Int @unique
  report LostPropertyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  name String @default("")
  contact String @default("")
  notes String @default("")
}

model FoundPropertyItem {
  id Int @id @default(autoincrement())
  description String
  category String @default("GENERAL")
  colour String @default("")
  brand String @default("")
  identifyingDetails String @default("")
  occurredAt DateTime @default(now())
  location String
  status String @default("SUBMITTED")
  version Int @default(1)
  reporterId Int
  reporter User @relation("ItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  ownerId Int?
  owner User? @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  custodianId Int?
  custodian User? @relation("ItemCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  storageLocation String @default("")
  depotId Int?
  depot Depot? @relation(fields: [depotId], references: [id], onDelete: Restrict)
  vehicleId Int?
  vehicle FleetVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookingId Int?
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  jobId Int?
  job Job? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  matches PropertyMatch[]
  custody PropertyCustodyEvent[]
  attachments Attachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, occurredAt])
  @@index([reporterId])
  @@index([ownerId])
  @@index([vehicleId, occurredAt])
  @@index([bookingId])
  @@index([jobId])
}

model PropertyMatch {
  id Int @id @default(autoincrement())
  reportId Int
  report LostPropertyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  itemId Int
  item FoundPropertyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  previousItemStatus String
  actorId Int
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  releaseReason String?
  createdAt DateTime @default(now())
  releasedAt DateTime?
  @@index([itemId, active])
  @@index([reportId, active])
}

model PropertyCustodyEvent {
  id Int @id @default(autoincrement())
  itemId Int
  item FoundPropertyItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actorId Int
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind String
  fromCustodianId Int?
  fromCustodian User? @relation("CustodyFrom", fields: [fromCustodianId], references: [id], onDelete: Restrict)
  toCustodianId Int?
  toCustodian User? @relation("CustodyTo", fields: [toCustodianId], references: [id], onDelete: Restrict)
  fromLocation String?
  toLocation String?
  details Json?
  createdAt DateTime @default(now())
}

model Attachment {
  id String @id @default(uuid())
  storageKey String @unique
  filename String
  mimeType String
  size Int
  state String @default("PENDING")
  uploaderId Int
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  noticeId Int?
  notice Notice? @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  incidentId Int?
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  updateId Int?
  update IncidentUpdate? @relation(fields: [updateId], references: [id], onDelete: Restrict)
  reportId Int?
  report LostPropertyReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  itemId Int?
  item FoundPropertyItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([state, createdAt])
  @@index([noticeId])
  @@index([incidentId])
  @@index([updateId])
  @@index([reportId])
  @@index([itemId])
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  title String
  href String
  entity String
  entityId Int
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}
