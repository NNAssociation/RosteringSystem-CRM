{
  "name": "backendserver",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src prisma/seed.ts *.json *.mjs *.ts --ignore-path ../.prettierignore",
    "format:check": "prettier --check src prisma/seed.ts *.json *.mjs *.ts --ignore-path ../.prettierignore",
    "test": "vitest run",
    "test:report": "vitest run --reporter=json --outputFile=test-results.json",
    "build": "prisma generate && node ../scripts/clean-backend-build.mjs && tsc",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build-run": "npm run build && npm start",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.18.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "prisma": "^7.4.1",
    "supabase": "^2.76.15",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0"
  },
  "dependencies": {
    "@clerk/express": "^2.1.15",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "svix": "2.7.0",
    "zod": "^4.3.6"
  }
}
