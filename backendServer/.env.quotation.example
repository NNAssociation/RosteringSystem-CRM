# Add these to the server environment. Never expose secrets through NEXT_PUBLIC_*.
BUSINESS_TIMEZONE=Australia/Sydney
QUOTATION_CURRENCY=AUD
# Set explicitly to 1000 for 10% if applicable to your business; default does not add tax.
QUOTATION_TAX_BASIS_POINTS=0
QUOTATION_VALIDITY_DAYS=14
COMPANY_NAME=Your Transport Company
PUBLIC_APP_URL=https://your-app.example.com
# Transactional email provider: brevo (default) or resend
EMAIL_PROVIDER=brevo

# Brevo configuration (default)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=bookings@your-domain.example
BREVO_REPLY_TO=bookings@your-domain.example
# Configure Brevo webhook with Authorization: Bearer <this secret>
BREVO_WEBHOOK_SECRET=

# Resend configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_WEBHOOK_SECRET=

# Generate a 32-byte random hex secret (64 characters). Keep stable to decrypt queued links.
QUOTATION_TOKEN_KEY=

